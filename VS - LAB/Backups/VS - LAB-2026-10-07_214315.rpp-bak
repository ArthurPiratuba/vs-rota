        <VIDEO_EFFECT "Video processor" ""
          <CODE
            |// Cartaz do bloco, texto editavel
            |font="Arial";
            |ini=0;
            |fim=732.551836734692;
            |(project_time<ini || project_time>=fim) ? 0 : (
            |project_wh_valid===0 ? input_info(-2,project_w,project_h);
            |gfx_a2=0;
            |gfx_blit(-2,1);
            |gfx_set(0,0,0,1);
            |gfx_fillrect(0,0,project_w,project_h);
            |px=project_h*0.13;
            |gfx_setfont(px,font);
            |#S=" ";
            |gfx_str_measure(#S,spw,sph);
            |#T="VS BLOCO 1";
            |gfx_str_measure(#T,tw,th);
            |widest=tw;
            |#L="Na Hora de Amar";
            |gfx_str_measure(#L,lw,lh);
            |#R="??";
            |gfx_str_measure(#R,rw,rh);
            |linew=lw+spw+rw;
            |linew>widest ? widest=linew;
            |n=2;
            |step=px*1.35;
            |total=step*n;
            |maxw=project_w*0.92;
            |maxh=project_h*0.88;
            |scale=1;
            |widest>maxw ? scale=maxw/widest;
            |total*scale>maxh ? scale=maxh/total;
            |px*=scale;
            |gfx_setfont(px,font);
            |gfx_str_measure(#S,spw,sph);
            |gfx_str_measure(#T,tw,th);
            |step=px*1.35;
            |y=(project_h-step*n)*0.5;
            |gfx_set(1,0,0,1);
            |gfx_str_draw(#T,(project_w-tw)*0.5,y);
            |y+=step;
            |#L="Na Hora de Amar";
            |gfx_str_measure(#L,lw,lh);
            |#R="??";
            |gfx_str_measure(#R,rw,rh);
            |x=(project_w-lw-spw-rw)*0.5;
            |gfx_set(1,1,1,1);
            |gfx_str_draw(#L,x,y);
            |gfx_set(1,0,0,1);
            |gfx_str_draw(#R,x+lw+spw,y);
            |y+=step;
            |);
          >
